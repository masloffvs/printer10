<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.setretailx</groupId>
  <artifactId>printer</artifactId>
  <name>SetRetailX Printer</name>
  <version>1.0.0-SNAPSHOT</version>
  <description>Java Swing migration of SetRetailX Printer</description>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.1</version>
      </plugin>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer>
                  <mainClass>com.setretailx.printer.PrinterApp</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <flatlaf.version>3.7.1</flatlaf.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <zxing.version>3.5.4</zxing.version>
    <jackson.version>2.22.3</jackson.version>
    <sqlite.version>3.51.1.0</sqlite.version>
  </properties>
</project>
