{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "setretailx-license-server",
	"main": "src/index.js",
	"compatibility_date": "2026-11-19",
	"workers_dev": true,
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "LICENSES",
			"database_name": "setretailx-licenses",
			"database_id": "REPLACE_WITH_D1_DATABASE_ID",
			"migrations_dir": "migrations"
		}
	]
}
