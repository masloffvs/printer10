# Copy this file to .env and fill in the real connection details.
SETRETAILX_RPC_URL=http://localhost:8090/SetXRMI/json-rpc/
SETRETAILX_USERNAME=your_username
SETRETAILX_PASSWORD=your_password
# Retries after a detected closed-connection failure (default: 5; set 0 to disable).
SETRETAILX_CONNECTION_RETRIES=5
