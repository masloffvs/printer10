# Copy this file to .env and fill in the real connection details.
SETRETAILX_RPC_URL=http://localhost:8090/SetXRMI/json-rpc/
SETRETAILX_USERNAME=your_username
SETRETAILX_PASSWORD=your_password
# Network role: exactly one parent PC per customer; other installations use child.
SETRETAILX_NODE_ROLE=parent
# Retries after a detected closed-connection failure (default: 5; set 0 to disable).
SETRETAILX_CONNECTION_RETRIES=5
# Optional SQLite file for price-change history, price snapshots, and task logs.
# Blank keeps the per-user default shared with the Python app.
SETRETAILX_TASKS_DB_PATH=
# Licensing: server URL and pinned public keys are required for production.
SETRETAILX_LICENSE_URL=
SETRETAILX_LICENSE_ENCRYPTION_KEY_FILE=
SETRETAILX_LICENSE_VERIFY_KEY_FILE=
SETRETAILX_LICENSE_KEY=
# Optional stable machine ID override for systems without a supported OS machine identifier.
SETRETAILX_LICENSE_DEVICE_ID=
